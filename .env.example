APP_NAME=Avela
APP_ENV=development
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=avela
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=avela_session
SESSION_TIMEOUT_MINUTES=30
SESSION_SECURE_COOKIE=false

PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_MINUTES=15
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@example.com
MAIL_FROM_NAME=Avela

RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Required only before optional authenticator enrollment; generate privately and retain a secure backup.
MFA_ENCRYPTION_KEY=your-base64-32-byte-mfa-key

# Executable path for the standard-library Python concern interpreter.
NLP_PYTHON_BINARY=python
