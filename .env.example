APP_NAME=Avela
APP_ENV=development
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=avela
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=avela_session
SESSION_TIMEOUT_MINUTES=30
SESSION_SECURE_COOKIE=false

PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_MINUTES=15
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

MAIL_DRIVER=smtp
# Explicit named staff OTP exception for a loopback disposable development database only.
MAIL_LOCAL_STAFF_OTP=false
MAIL_LOCAL_STAFF_USERNAMES=avela_admin,avela_catalog
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@example.com
MAIL_FROM_NAME=Avela

RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Required only before optional authenticator enrollment; generate privately and retain a secure backup.
MFA_ENCRYPTION_KEY=your-base64-32-byte-mfa-key

# Executable path for the standard-library Python concern interpreter.
NLP_PYTHON_BINARY=python

MAYA_ENV=sandbox
MAYA_PUBLIC_KEY=your-maya-sandbox-public-key
MAYA_SECRET_KEY=your-maya-sandbox-secret-key
PRIVACY_CONTACT_EMAIL=
PRIVACY_CONTACT_VERIFIED=false
# Approved for new coursework deployments; existing private overrides are not changed by source updates.
PASSWORD_EXPIRY_DAYS=90
# Existing accounts with unknown password age: set an approved future UTC deadline.
PASSWORD_LEGACY_GRACE_END=
# Enable only after service-identity acceptance. No fake scanning fallback.
UPLOAD_SCANNER=disabled
UPLOAD_DEFENDER_BINARY=
# Separately approved schema/backfill and a protected external keyring are required.
PII_ENCRYPTION_ENABLED=false
PII_KEYRING_FILE=
MAIL_DEV_OUTBOX_DIRECTORY=
MAYA_ENVIRONMENT=sandbox
MAYA_MERCHANT_ORIGIN=https://your-sandbox-merchant.example
MAYA_SANDBOX_ENABLED=false
MAYA_WEBHOOK_READY=false
MAYA_RECONCILIATION_READY=false
# Local simulation requires the guarded local launcher and a disposable database.
MAYA_LOCAL_SIMULATION=false
# Explicit localhost hosted Sandbox testing requires a guarded launcher and disposable DB.
MAYA_LOCAL_HOSTED_SANDBOX=false
